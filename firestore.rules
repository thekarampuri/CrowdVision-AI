service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly allow the original alerts collection (Deprecated)
    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }
    
    // Explicitly allow the new high_risk_alerts collection (REQUIRED for Dashboard)
    match /high_risk_alerts/{alertId} {
      allow read, write: if request.auth != null;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
